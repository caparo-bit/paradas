(function () {
  const NTFY_BASE = "https://ntfy.sh";
  const SW_URL = "sw.js";
  const SW_SCOPE = new URL("./", document.baseURI).pathname;

  // ------------------------------------------------------------
  // Registrar el Service Worker
  // ------------------------------------------------------------
  async function registrarSW() {
    if (!("serviceWorker" in navigator)) {
      console.warn("[Push] Service Worker no soportado");
      return null;
    }
    try {
      const reg = await navigator.serviceWorker.register(SW_URL, { scope: SW_SCOPE });
      console.log("[Push] SW registrado:", reg.scope);
      return reg;
    } catch (e) {
      console.error("[Push] Error registrando SW:", e);
      return null;
    }
  }

  // ------------------------------------------------------------
  // base64url → Uint8Array
  // ------------------------------------------------------------
  function urlBase64ToUint8Array(base64String) {
    const padding = "=".repeat((4 - (base64String.length % 4)) % 4);
    const base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/");
    const rawData = atob(base64);
    const outputArray = new Uint8Array(rawData.length);
    for (let i = 0; i < rawData.length; ++i) {
      outputArray[i] = rawData.charCodeAt(i);
    }
    return outputArray;
  }

  // ------------------------------------------------------------
  // ArrayBuffer → base64 (sin spread, evita RangeError)
  // ------------------------------------------------------------
  function bufferToBase64(buffer) {
    const bytes = new Uint8Array(buffer);
    let binary = "";
    for (let i = 0; i < bytes.byteLength; i++) {
      binary += String.fromCharCode(bytes[i]);
    }
    return btoa(binary);
  }

  // ------------------------------------------------------------
  // Suscribirse a Web Push (solo funciona en servidores
  // autoalojados con VAPID configurado. En ntfy.sh público
  // devolverá error, pero lo intentamos por si acaso).
  // ------------------------------------------------------------
  async function suscribirWebPush(topic) {
    if (!("serviceWorker" in navigator) || !("PushManager" in window)) {
      return { ok: false, motivo: "Web Push no soportado en este navegador" };
    }
    if (!("Notification" in window)) {
      return { ok: false, motivo: "Notificaciones no soportadas" };
    }

    const permiso = await Notification.requestPermission();
    if (permiso !== "granted") {
      return { ok: false, motivo: "Permiso de notificaciones denegado" };
    }

    try {
      const reg = await registrarSW();
      if (!reg) return { ok: false, motivo: "No se pudo registrar el Service Worker" };

      await navigator.serviceWorker.ready;

      // Intentar obtener la VAPID key del servidor ntfy
      let vapidKey = null;
      try {
        const res = await fetch(`${NTFY_BASE}/v1/config`);
        if (res.ok) {
          const cfg = await res.json();
          vapidKey = cfg["web-push-public-key"] || null;
        }
      } catch (e) {
        // Ignorar
      }

      if (!vapidKey) {
        return {
          ok: false,
          motivo: "ntfy.sh público no expone Web Push para terceros. Usa la app oficial de ntfy o autoaloja tu servidor.",
          necesitaApp: true,
        };
      }

      let sub = await reg.pushManager.getSubscription();
      if (!sub) {
        sub = await reg.pushManager.subscribe({
          userVisibleOnly: true,
          applicationServerKey: urlBase64ToUint8Array(vapidKey),
        });
      }

      // Intentar registrar la suscripción en ntfy
      // (este endpoint solo existe en servidores autoalojados con Web Push)
      const payload = {
        endpoint: sub.endpoint,
        keys: {
          p256dh: bufferToBase64(sub.getKey("p256dh")),
          auth: bufferToBase64(sub.getKey("auth")),
        },
      };

      const res = await fetch(`${NTFY_BASE}/${encodeURIComponent(topic)}/subscribe`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      if (!res.ok) {
        return {
          ok: false,
          motivo: "El servidor ntfy no aceptó la suscripción Web Push (código " + res.status + ").",
          necesitaApp: true,
        };
      }

      return { ok: true, endpoint: sub.endpoint };
    } catch (e) {
      console.error("[Push] Error en Web Push:", e);
      return { ok: false, motivo: e.message, necesitaApp: true };
    }
  }

  // ------------------------------------------------------------
  // Desuscribir de Web Push
  // ------------------------------------------------------------
  async function desuscribirWebPush() {
    try {
      const reg = await navigator.serviceWorker.getRegistration(SW_SCOPE);
      if (!reg) return { ok: false };
      const sub = await reg.pushManager.getSubscription();
      if (sub) await sub.unsubscribe();
      return { ok: true };
    } catch (e) {
      console.error("[Push] Error desuscribiendo:", e);
      return { ok: false, motivo: e.message };
    }
  }

  // ------------------------------------------------------------
  // Publicar un mensaje de prueba en el topic
  // ------------------------------------------------------------
  async function probarNotificacion(topic) {
    try {
      const res = await fetch(`${NTFY_BASE}/${encodeURIComponent(topic)}`, {
        method: "POST",
        headers: { "Title": "🔥 TaxiDiario prueba", "Priority": "high", "Tags": "fire" },
        body: "Si ves esto, las notificaciones funcionan correctamente.",
      });
      return res.ok;
    } catch (e) {
      return false;
    }
  }

  // ------------------------------------------------------------
  // API pública
  // ------------------------------------------------------------
  window.TaxiPush = {
    registrarSW,
    suscribirWebPush,
    desuscribirWebPush,
    probarNotificacion,
    estaSoportado: () => "serviceWorker" in navigator && "PushManager" in window,
    permisos: () => ("Notification" in window ? Notification.permission : "unsupported"),
    NTFY_BASE,
  };
})();
